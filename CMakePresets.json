{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "ci-release",
      "displayName": "CI Release",
      "generator": "Ninja",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/CI-Release"
    },
    {
      "name": "ci-debug",
      "displayName": "CI Debug",
      "generator": "Ninja",
      "inherits": "debug",
      "binaryDir": "${sourceDir}/build/CI-Debug"
    },
    {
      "name": "windows-ci",
      "displayName": "Windows CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Windows-CI",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_MANIFEST_FEATURES": "directx12;examples;opengl;tests;vulkan",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-clang-ci",
      "displayName": "Windows Clang CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Windows-Clang-CI",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-windows-static",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-gcc-ci",
      "displayName": "Windows GCC CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Windows-GCC-CI",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc",
        "CMAKE_CXX_COMPILER": "g++",
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-mingw-dynamic",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/Linux-CI",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "x64-linux",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      }
    },
    {
      "name": "macos-ci",
      "displayName": "macOS CI",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/macOS-CI",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_TOOLCHAIN_FILE": "$penv{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_MANIFEST_DIR": "${sourceDir}",
        "VCPKG_MANIFEST_MODE": true,
        "VCPKG_INSTALLED_DIR": "${sourceDir}/vcpkg_installed",
        "VCPKG_TARGET_TRIPLET": "arm64-osx",
        "VCPKG_MANIFEST_FEATURES": "tests",
        "VCPKG_MANIFEST_NO_DEFAULT_FEATURES": true
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      }
    }
  ],
  "buildPresets": [
    { "name": "release", "displayName": "Release", "configurePreset": "release" },
    { "name": "debug", "displayName": "Debug", "configurePreset": "debug" },
    { "name": "ci-release", "displayName": "CI Release", "configurePreset": "ci-release" },
    { "name": "ci-debug", "displayName": "CI Debug", "configurePreset": "ci-debug" },
    {
      "name": "windows-ci",
      "displayName": "Windows CI",
      "configurePreset": "windows-ci",
      "targets": [
        "rt-opengl",
        "rt-vulkan",
        "rt-d3d12",
        "rt-validation-layer",
        "rt-logging-layer",
        "rtsl-tests",
        "rtsl-sdk-tests",
        "rtslc"
      ]
    },
    {
      "name": "windows-clang-ci",
      "displayName": "Windows Clang CI",
      "configurePreset": "windows-clang-ci",
      "targets": ["rtsl-tests", "rtsl-sdk-tests", "rtslc"]
    },
    {
      "name": "windows-gcc-ci",
      "displayName": "Windows GCC CI",
      "configurePreset": "windows-gcc-ci",
      "targets": ["rtsl-tests", "rtsl-sdk-tests", "rtslc"]
    },
    {
      "name": "linux-ci",
      "displayName": "Linux CI",
      "configurePreset": "linux-ci",
      "targets": ["rtsl-tests", "rtsl-sdk-tests", "rtslc"]
    },
    {
      "name": "macos-ci",
      "displayName": "macOS CI",
      "configurePreset": "macos-ci",
      "targets": ["rtsl-tests", "rtsl-sdk-tests", "rtslc"]
    }
  ],
  "testPresets": [
    { "name": "release", "displayName": "Release", "configurePreset": "release", "output": { "outputOnFailure": true } },
    { "name": "debug", "displayName": "Debug", "configurePreset": "debug", "output": { "outputOnFailure": true } },
    { "name": "ci-release", "displayName": "CI Release", "configurePreset": "ci-release", "output": { "outputOnFailure": true } },
    { "name": "ci-debug", "displayName": "CI Debug", "configurePreset": "ci-debug", "output": { "outputOnFailure": true } },
    { "name": "windows-ci", "displayName": "Windows CI", "configurePreset": "windows-ci", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-clang-ci", "displayName": "Windows Clang CI", "configurePreset": "windows-clang-ci", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "windows-gcc-ci", "displayName": "Windows GCC CI", "configurePreset": "windows-gcc-ci", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "linux-ci", "displayName": "Linux CI", "configurePreset": "linux-ci", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } },
    { "name": "macos-ci", "displayName": "macOS CI", "configurePreset": "macos-ci", "output": { "outputOnFailure": true }, "execution": { "noTestsAction": "error" } }
  ]
}
