struct Scene {
	mat4 view_projection;
	vec4 light_direction;
	f32 time;
};

struct Point {
	vec3 position;
	vec4 color;
	vec3 normal;
	f32 kind;
	f32 seed;
};

uniform Scene scene;

struct Vertex : Position {
	vec4 color;
	vec3 normal;
	f32 kind;
	f32 seed;

	fn Vertex(Point point) : Position(scene.view_projection * vec4(point.position, 1.0)) {
		color = point.color;
		normal = point.normal;
		kind = point.kind;
		seed = point.seed;
	}
};

@stage : vertex
fn main(Point point) -> Vertex {
	return Vertex(point);
}

@stage : fragment
fn main(Vertex vertex{.color : smooth, .normal : smooth, .kind : flat, .seed : flat}) -> vec4 {
	var f32 diffuse = 0.5 + 0.5 * (vertex.normal.x * scene.light_direction.x + vertex.normal.y * scene.light_direction.y + vertex.normal.z * scene.light_direction.z);
	var f32 star_light = 1.05 + diffuse * 0.55;
	var f32 planet_light = 0.12 + diffuse * 0.92;
	var f32 light = star_light * (1.0 - vertex.kind) + planet_light * vertex.kind;
	return vec4(vertex.color.xyz * light, vertex.color.w);
}
