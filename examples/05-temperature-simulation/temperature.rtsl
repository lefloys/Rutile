var image_2d<f32> temperature_in;
var image_2d<f32> temperature_out;

struct Brush {
	usize x;
	usize y;
	usize radius;
	usize active;
	f32 strength;
}

uniform Brush brush;

struct Point {
	vec2 position;
	vec2 uv;
}

struct Vertex : Position {
	vec2 uv;

	fn Vertex(Point point) {
		position = vec4(point.position, 0.0, 1.0);
		uv = point.uv;
	}
}

fn previous(usize value) -> usize {
	if (value == 0) {
		return 0;
	}
	return value - 1;
}

fn next(usize value, usize limit) -> usize {
	if (value + 1 >= limit) {
		return limit - 1;
	}
	return value + 1;
}

fn distance(usize left, usize right) -> usize {
	if (left > right) {
		return left - right;
	}
	return right - left;
}

@stage : compute 
fn temperature<16, 16, 1>(usize x, usize y, usize z) {
	var vec2<usize> size = temperature_out.size();
	if (x >= size.x || y >= size.y) {
		return;
	}

	var usize west = previous(x);
	var usize east = next(x, size.x);
	var usize north = previous(y);
	var usize south = next(y, size.y);
	var f32 center = temperature_in[x, y];
	var f32 cardinal = temperature_in[x, north] + temperature_in[x, south] + temperature_in[east, y] + temperature_in[west, y];
	var f32 diagonal = temperature_in[west, north] + temperature_in[east, north] + temperature_in[west, south] + temperature_in[east, south];
	var f32 heat = center + (((cardinal + diagonal * 0.25) * 0.2) - center) * 0.328125;
	if (brush.active != 0 && distance(x, brush.x) <= brush.radius && distance(y, brush.y) <= brush.radius) {
		heat = heat + brush.strength;
	}
	if (heat > 1.0) {
		heat = 1.0;
	}
	if (heat < 0.0) {
		heat = 0.0;
	}
	temperature_out[x, y] = heat;
}

@stage : vertex
fn display(Point point) -> Vertex {
	return Vertex(point);
}

@stage : fragment
fn display(Vertex vertex) -> vec4 {
	var f32 heat = temperature_out.sample(vertex.uv);
	return vec4(heat, heat, heat, 1.0);
}
