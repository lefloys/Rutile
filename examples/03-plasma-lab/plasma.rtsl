var texture_2d<f32> plasma;

struct Point {
	vec2 position;
	vec2 uv;
};

struct Vertex : Position {
	vec2 uv;

	fn Vertex(Point point) : Position(vec4(point.position, 0.0, 1.0)) {
		uv = point.uv;
	}
};

@stage : vertex
fn main(Point point) -> Vertex {
	return Vertex(point);
}

@stage : fragment
fn main(Vertex vertex{.uv : smooth}) -> vec4 {
	return sample(plasma, vertex.uv);
}
