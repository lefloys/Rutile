struct SoftwareVertexInput {
	vec3 position;
	vec4 color;
};

struct SoftwareVertex : Position {
	vec4 color;

	fn SoftwareVertex(SoftwareVertexInput input) : Position(input.position) {
		color = input.color;
	}
};

@stage : vertex
fn main(SoftwareVertexInput input) -> SoftwareVertex {
	return SoftwareVertex(input);
}

@stage : fragment
fn main(SoftwareVertex vertex) -> vec4 {
	return vertex.color;
}
